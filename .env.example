# Copia estos valores como variables de entorno en tu servidor (Render, Railway, Fly, etc.).
# No subas un archivo con valores reales a ningún repositorio público.

# Clave que tendrás que escribir una vez en la app (mínimo 12 caracteres, inventa una larga).
API_TOKEN=cambia-esto-por-una-clave-larga

# Cuenta de Twilio (https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número o remitente de Twilio desde el que sale el SMS, con +código de país
TWILIO_FROM=

# Teléfono de tu familiar, con +código de país. Ej: +56912345678
# Debe haber aceptado recibir estos avisos.
FAMILY_PHONE=

# Opcional
# MAX_ALERTS_PER_HOUR=3
# PORT=3000
